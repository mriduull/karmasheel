# Python-generated files
__pycache__/
*.py[cod]
*.pyo

# Project virtual environments
.venv/
venv/

# Node.js dependencies
node_modules/

# Environment variables and secrets
.env

# Django-generated files
db.sqlite3
staticfiles/
media/

# Test and coverage files
.pytest_cache/
.coverage
htmlcov/
*.log

