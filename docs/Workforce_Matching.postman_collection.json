  "item": [
    {
      "name": "00 - Public setup",
      "description": "The taxonomy command must already have been run. This request stores the Construction & Repair and Electrical IDs used by later requests.",
      "item": [
        {
          "name": "Load taxonomy tree and save Electrical IDs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Taxonomy loaded', () => pm.response.to.have.status(200));",
                  "const tree = pm.response.json();",
                  "const category = tree.find(item => item.name === 'Construction & Repair') || tree[0];",
                  "const subcategory = category && (category.subcategories.find(item => item.name === 'Electrical') || category.subcategories[0]);",
                  "pm.expect(category, 'seeded category').to.exist;",
                  "pm.expect(subcategory, 'seeded subcategory').to.exist;",
                  "pm.collectionVariables.set('category_id', String(category.id));",
                  "pm.collectionVariables.set('subcategory_id', String(subcategory.id));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/taxonomy/tree/"
          }
        },
        {
          "name": "Browse active jobs (public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Public browse is available', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/jobs/browse/?category={{category_id}}&subcategory={{subcategory_id}}"
          }
        }
      ]
    },
