# Base URL of the Django backend API — no trailing slash, no /api suffix
# (the client appends /api/... itself). Must match the origin this
# frontend dev server runs on being present in the backend's own
# CORS_ALLOWED_ORIGINS (../.env) — local dev default there already
# includes http://localhost:5173 and http://127.0.0.1:5173.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Geoapify API key — powers the interactive location picker's map tiles,
# address autocomplete, and reverse geocoding (src/lib/geoapify.ts,
# src/components/shared/LocationPicker.tsx). Get a free key at
# https://myprojects.geoapify.com/.
#
# IMPORTANT: in the Geoapify dashboard, restrict this key to your actual
# frontend origins (e.g. http://localhost:5173, http://127.0.0.1:5173, and
# your deployed domain) under Project > API keys > referrer restrictions —
# an unrestricted key can be used by anyone who reads it out of this
# bundled frontend build.
#
# Without this key: the location picker still renders (map, marker,
# click/drag, "use my current location") but address search/autocomplete
# and reverse geocoding are unavailable, and the map has no tiles. Saving
# coordinates picked directly on the map still works.
VITE_GEOAPIFY_API_KEY=your-geoapify-api-key

# Copy this file to frontend/.env for local development:
#   cp .env.example .env
# .env is gitignored and must never contain secrets — this project has
# none to put here anyway (no API keys, no client secrets).
#
# `npm run dev` now runs Vite with a strict port (5173) — see
# vite.config.ts — so it fails loudly instead of silently switching ports
# when 5173 is occupied. If you deliberately run on 5174 instead
# (`npm run dev -- --port 5174`), the backend's CORS_ALLOWED_ORIGINS
# (../.env) must also explicitly include http://localhost:5174 and
# http://127.0.0.1:5174, or the browser will block every API request.
# See docs/DEVELOPMENT_SETUP.md for the full explanation.
