# Used only by Vitest (mode "test"). Not a secret — same non-sensitive
# value documented in .env.example. Requests in tests are intercepted by
# MSW (src/test/msw) and never leave the process, so this URL is never
# actually dialed.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Not a real key — Geoapify calls in tests always go through
# src/lib/geoapify.ts, which every test mocks (`vi.mock('@/lib/geoapify')`)
# rather than hitting the network. This only needs to be a non-empty
# string so `isGeoapifyConfigured()` reads as "configured" by default; the
# one test that exercises the missing-key path unsets it with
# `vi.stubEnv('VITE_GEOAPIFY_API_KEY', '')`.
VITE_GEOAPIFY_API_KEY=test-geoapify-key
