DJANGO_SECRET_KEY=your-django-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# auto | weasyprint | browser | basic
CV_PDF_ENGINE=auto

DB_NAME=karmasheel_db
DB_USER=karmasheel_user
DB_PASSWORD=your-postgresql-password
DB_HOST=localhost
DB_PORT=5432

# Comma-separated list of origins allowed to make cross-origin requests
# to this API (e.g. the local frontend dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Matching thresholds (finite values; score bands use the inclusive 0-100 range)
SKILL_MATCH_THRESHOLD=85
RECOMMENDATION_MAX_DISTANCE_KM=20
RECOMMENDATION_NEAR_MISS_MIN_SCORE=40
RECOMMENDATION_NEAR_MISS_MAX_SCORE=75
