# Copy this file to .env in the repository root and fill in your own local
# values — never commit .env (it is already listed in .gitignore).
#   cp .env.example .env

# Django's cryptographic secret key. Generate your own, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Do not reuse this placeholder value anywhere.
DJANGO_SECRET_KEY=your-django-secret-key

# True for local development. Must be False in production. seed_demo
# (backend/accounts/management/commands/seed_demo.py) refuses to run
# when this is False, unless --force is passed.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# auto | weasyprint | browser | basic
CV_PDF_ENGINE=auto

# PostgreSQL connection settings — match these to a database/role you
# create locally (see docs/DEVELOPMENT_SETUP.md), or to a shared hosted
# database if your team uses one. Never commit a real password.
DB_NAME=karmasheel_db
DB_USER=karmasheel_user
DB_PASSWORD=your-postgresql-password
DB_HOST=localhost
DB_PORT=5432

# Comma-separated list of origins allowed to make cross-origin requests to
# this API (django-cors-headers, CORS_ALLOWED_ORIGINS in
# backend/config/settings.py). No wildcard is ever used
# (CORS_ALLOW_ALL_ORIGINS is not enabled). Includes both the default Vite
# dev-server port (5173, strict — see frontend/vite.config.ts) and the
# documented manual-fallback port (5174, only used if you explicitly start
# Vite with --port 5174 because 5173 was already occupied — see
# docs/DEVELOPMENT_SETUP.md). localhost and 127.0.0.1 are distinct origins
# to a browser, so both forms are listed for each port.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional — every variable below has a working default in
# backend/config/settings.py and only needs to be set here to override
# that default for local experimentation.

# RapidFuzz confidence (0-100) above which a fuzzy skill-name match is
# auto-accepted instead of being stored for admin review. Defaults to 85.
# SKILL_MATCH_THRESHOLD=85

# Recommendation-engine tuning (backend/recommendations/services.py).
# Distance (km) at which the distance component of a match score reaches
# 0. Defaults to 20.
# RECOMMENDATION_MAX_DISTANCE_KM=20

# Inclusive final-score range treated as a "near miss" by the opportunity
# advisory. Defaults to 40 / 75.
# RECOMMENDATION_NEAR_MISS_MIN_SCORE=40
# RECOMMENDATION_NEAR_MISS_MAX_SCORE=75
